{
  "require-dev": {
    "phpstan/phpstan": "^1.0",
    "php-stubs/wordpress-stubs": "^6.0",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "rector/rector": "^1.2",
    "kint-php/kint": "^5.0",
    "phpunit/phpunit": "^10",
    "pestphp/pest": "^2.36"
  },
  "scripts": {
    "analyse": "vendor/bin/phpstan analyse > storage/framework/phpstan/phpstan.log || true",
    "rector": "vendor/bin/rector process --dry-run > storage/framework/rector/rector.log || true",
    "rector-fix": "vendor/bin/rector process > storage/framework/rector/rector-fix.log || true",
    "test": "vendor/bin/pest -v"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "bootstrap/functions.php"
    ]
  },
  "require": {
    "monolog/monolog": "^3.0"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "platform": {
      "php": "8.2.0"
    }
  }
}
